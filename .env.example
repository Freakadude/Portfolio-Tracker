# Copy to .env and fill in. Never commit .env.
# Generate FOLIO_SECRET_KEY with: uv run folio init
FOLIO_SECRET_KEY=
FOLIO_LAN_IP=192.168.1.10
# FOLIO_WEB_PORT=8555   # the port Folio is reachable on (default 8555)

# Optional
# FOLIO_DB_URL=sqlite:////data/folio.db
# FOLIO_BASE_URL=http://192.168.1.10:8555
# FOLIO_TZ=Europe/Amsterdam
# FOLIO_LOG_LEVEL=INFO
# FOLIO_IMAGE=ghcr.io/freakadude/portfolio-tracker:latest   # pin a build, e.g. :sha-<commit>
# FOLIO_BACKUP_DIR=/data/backups
# FOLIO_EXTRA_BACKUP_DIR=
# Sign in through Tailscale Serve's identity (off unless both are set; see docs/deployment.md)
# FOLIO_TAILSCALE_USER=you@example.com
# FOLIO_TRUSTED_PROXIES=172.18.0.1

# Optional env overrides; normally entered in Settings and stored encrypted
# ANTHROPIC_API_KEY=
# EODHD_API_KEY=
# TWELVEDATA_API_KEY=
# OPENFIGI_API_KEY=
# FRED_API_KEY=
